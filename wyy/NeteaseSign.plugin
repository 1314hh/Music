#!name=网易云音乐每日签到
#!desc=自动获取网易云音乐Cookie，每天08:05自动签到
#!author=zi song

[Script]

http-request ^https:\/\/(music|interface|interface3)\.163\.com\/.* script-path=https://raw.githubusercontent.com/1314hh/Music/main/wyy/NeteaseCookie.js,requires-body=false,timeout=10,tag=网易云自动获取Cookie,enable=true

cron "0 5 8 * * *" script-path=https://raw.githubusercontent.com/1314hh/Music/main/wyy/NeteaseSign.js,timeout=30,tag=网易云音乐每日签到,enable=true

[MITM]

hostname = music.163.com,interface.music.163.com,interface3.music.163.com
